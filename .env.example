DB_HOST=localhost
DB_PORT=5432
DB_NAME=classhub
DB_USERNAME=classhub
DB_PASSWORD=CHANGE_ME

# Session cookie: set true behind HTTPS in production (required with SPRING_PROFILES_ACTIVE=prod default)
CLASSHUB_COOKIE_SECURE=false

# Session idle timeout (Spring Duration, e.g. 8h, 30m)
CLASSHUB_SESSION_TIMEOUT=8h

# Comma-separated browser origins for credentialed CORS. Never use "*".
# Example production: https://app.example.edu
CLASSHUB_CORS_ALLOWED_ORIGINS=http://localhost:3000

# First-run SUPER_ADMIN bootstrap (omit both after the admin exists)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Super
BOOTSTRAP_ADMIN_LAST_NAME=Admin

# Local file storage root for coursework attachments (outside web roots; single-instance MVP)
# In Docker Compose this is mounted at /data/classhub-storage
CLASSHUB_STORAGE_PATH=./data/classhub-storage

# Max upload size (Spring DataSize, e.g. 20MB). Keep multipart limits in sync via application.yml.
CLASSHUB_MAX_ATTACHMENT_SIZE=20MB

# Max course-unit cover image size (default 5MB)
CLASSHUB_MAX_COURSE_UNIT_COVER_SIZE=5MB

# AI note processor selection for future real providers (currently only local is implemented).
# CLASSHUB_AI_PROVIDER=local|openai|ollama
# Student BYOK API keys are not stored yet — see docs/BYOK-AI.md
CLASSHUB_AI_PROVIDER=local

# Optional: activate production-safe defaults (secure cookies, reduced logging, etc.)
# SPRING_PROFILES_ACTIVE=prod

# Notification orchestration (IN_APP always on; external channels off until providers are wired)
CLASSHUB_WEB_BASE_URL=http://localhost:5173
CLASSHUB_NOTIFICATION_TIMEZONE=Africa/Kampala
CLASSHUB_NOTIFICATIONS_ENABLED=true
CLASSHUB_DEADLINE_REMINDERS_ENABLED=true

# Brevo transactional email. Verify BREVO_SENDER_EMAIL in Brevo before enabling.
CLASSHUB_EMAIL_NOTIFICATIONS_ENABLED=false
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=
BREVO_SENDER_NAME=ClassHub
BREVO_SENDER_EMAIL=
BREVO_REPLY_TO_EMAIL=
# true validates requests without delivering email; set false for real delivery.
BREVO_SANDBOX=false

# Meta WhatsApp Cloud API. Create and approve the template documented in
# docs/provider-templates/whatsapp-classhub-notification.md before enabling.
CLASSHUB_WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v24.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=classhub_notification
WHATSAPP_TEMPLATE_LANGUAGE=en
